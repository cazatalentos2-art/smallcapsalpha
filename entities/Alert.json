{
  "name": "Alert",
  "type": "object",
  "properties": {
    "ticker": {
      "type": "string",
      "description": "Stock ticker symbol"
    },
    "condition_type": {
      "type": "string",
      "enum": [
        "score_above",
        "rvol_above",
        "volume_spike",
        "breakout",
        "custom"
      ],
      "description": "Type of alert condition"
    },
    "threshold": {
      "type": "number",
      "description": "Threshold value"
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "in_app"
      ],
      "description": "Notification channel"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the alert is active"
    },
    "last_triggered": {
      "type": "string",
      "format": "date-time",
      "description": "Last time alert was triggered"
    }
  },
  "required": [
    "ticker",
    "condition_type",
    "threshold",
    "channel"
  ]
}